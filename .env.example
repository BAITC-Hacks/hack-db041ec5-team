# Copy this file to .env; put your real key ONLY in .env (never in this example).
OPENAI_API_KEY=
MONEYGRAPH_LLM_PROVIDER=openai
MONEYGRAPH_LLM_BASE_URL=https://api.openai.com/v1
MONEYGRAPH_LLM_MODEL=gpt-4.1-mini

# Optional signing secret for uploaded results; defaults to the server API key.
MONEYGRAPH_SESSION_SECRET=

# Необязательные пути. По умолчанию data/ и output/ рядом с app.py.
# MONEYGRAPH_DATA_DIR=
# MONEYGRAPH_OUTPUT_DIR=
# MONEYGRAPH_DEMO=0
