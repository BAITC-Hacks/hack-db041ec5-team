# NVIDIA API Catalog. Сам ключ храните только в локальном .env.
MONEYGRAPH_LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
MONEYGRAPH_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
MONEYGRAPH_LLM_MODEL=

# Для OpenAI: provider=openai, base_url=https://api.openai.com/v1
# OPENAI_API_KEY=

# Необязательные пути. По умолчанию data/ и output/ рядом с app.py.
# MONEYGRAPH_DATA_DIR=
# MONEYGRAPH_OUTPUT_DIR=
# MONEYGRAPH_DEMO=0
